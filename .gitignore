# secrets — never commit
.netrc
.git-credentials
*.token

# owner data — never commit (OWNER PC ONLY boundary)
uploads/

# bundles — GitHub Releases only, by explicit owner order
*.zip
*.7z
*.rar

# caches / build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# local scratch / tooling artifacts
memcheck/
perf_lab/
smoke/
.build_*.sha
.closure_*.sha
.tools_gate_*.txt
.build_mutations.json

# v30 per-combo equity curves (regenerable, ~27MB each) — keep only the official equity_v30.csv
halal_spot/results/equity_v30_*.csv

# v32 price archives — fetched by halal_spot/fetch_binance_5m.py on the owner PC.
# Code only is pushed; never the kline archives (~35 MB per coin-month set).
halal_spot/data/binance_5m/
